import numpy as np

def walsh(n):
    """Walsh-Hadamard matrix of order n (n a power of 2); rows are orthogonal codes."""
    H = np.array([[1]])
    while H.shape[0] < n:
        H = np.block([[H, H], [H, -H]])
    return H

rng = np.random.default_rng(11)
N, users, nbits = 8, 3, 6          # chips per bit, users, bits per user
codes = walsh(N)[:users]
print("Walsh codes (chips):"); print(codes)
print("Code correlation matrix / N:"); print(codes @ codes.T // N)

bits = rng.integers(0, 2, (users, nbits)) * 2 - 1                 # data as +1 / -1
tx = np.array([np.kron(bits[u], codes[u]) for u in range(users)])  # spreading
channel = tx.sum(axis=0)                                           # all users share the channel

for sigma in (0.0, 1.0, 2.0):
    rx = channel + rng.normal(0, sigma, channel.shape)
    chips = rx.reshape(nbits, N)
    est = np.sign(chips @ codes.T / N).T                           # despreading (correlation)
    errors = int((est != bits).sum())
    print(f"noise sigma = {sigma}: bit errors = {errors} of {users * nbits}")

print("Sent user 1    :", bits[0])
print("Received user 1:", est[0].astype(int), "(last run, sigma = 2.0)")
rx0 = channel.reshape(nbits, N)
print("Wrong code (user 4 = Walsh row 7):", np.sign(rx0 @ walsh(N)[7] / N).astype(int))
