import numpy as np

# ---- parameters (change U to 10 / 20 for step 6; keep dist the same length as U) ----
U, RB, TTI = 5, 50, 3000
dist = np.array([100, 200, 300, 400, 500.0])
# for U users spread evenly between 100 m and 500 m use:  dist = np.linspace(100, 500, U)

mean_snr_db = 40 - 35 * np.log10(dist / 100)     # mean SNR falls with distance
mean_snr = 10 ** (mean_snr_db / 10)

def rate(snr):                                    # bits per RB per ms (180 kHz, 1 ms)
    return np.minimum(np.log2(1 + snr), 6.0) * 180.0   # capped spectral efficiency

def simulate(sched, rng):
    thr = np.zeros(U)
    avg = np.ones(U)                              # PF average throughput
    for t in range(TTI):
        fade = rng.exponential(1.0, (U, RB))      # Rayleigh power fading per RB
        r = rate(mean_snr[:, None] * fade)        # achievable rate, U x RB
        if sched == "RR":
            owner = (np.arange(RB) + t) % U
        elif sched == "MAXCI":
            owner = r.argmax(axis=0)
        else:                                     # proportional fair
            owner = (r / avg[:, None]).argmax(axis=0)
        got = np.bincount(owner, weights=r[owner, np.arange(RB)], minlength=U)
        avg = 0.99 * avg + 0.01 * got
        thr += got
    return thr / TTI / 1000                       # Mbps

def jain(x):
    return x.sum() ** 2 / (len(x) * (x ** 2).sum())

rng = np.random.default_rng(3)
results = {}
print(f"{'Sched':6}" + "".join(f"{'UE' + str(i+1):>8}" for i in range(U)) + f"{'Total':>9}{'Jain':>8}")
for s in ("RR", "MAXCI", "PF"):
    x = simulate(s, rng)
    results[s] = x
    print(f"{s:6}" + "".join(f"{v:8.2f}" for v in x) + f"{x.sum():9.2f}{jain(x):8.3f}")
