def erlang_b(E, C):
    """Blocking probability for offered load E (erlang) and C channels (iterative form)."""
    b = 1.0
    for m in range(1, C + 1):
        b = E * b / (m + E * b)
    return b

def channels_needed(E, gos):
    C = 1
    while erlang_b(E, C) > gos:
        C += 1
    return C

def max_load(C, gos, hi=500.0):
    lo = 0.0
    for _ in range(60):                     
        mid = (lo + hi) / 2
        lo, hi = (mid, hi) if erlang_b(mid, C) < gos else (lo, mid)
    return lo

print("Blocking probability B(E, C)")
loads = (2, 5, 10, 20)
print(f"{'C':>4}" + "".join(f"{'E=' + str(e):>10}" for e in loads))
for C in (5, 10, 20, 30):
    print(f"{C:4d}" + "".join(f"{erlang_b(e, C):10.4f}" for e in loads))

# ---- parameters ----
users, calls_per_hour, hold_s = 2000, 1.5, 120
E = users * calls_per_hour * hold_s / 3600
print(f"\nOffered load: {users} users x {calls_per_hour} calls/h x {hold_s} s = {E:.1f} erlang")
for gos in (0.05, 0.02, 0.01):
    print(f"GOS {gos:.0%}: channels needed = {channels_needed(E, gos)}")
print(f"Max load for 20 channels at 2% blocking: {max_load(20, 0.02):.2f} erlang")

# Step 6: trunking efficiency - one group of 30 channels vs three groups of 10 at the same total load
total_load = 3 * max_load(10, 0.02)
print(f"\nTrunking efficiency at total load {total_load:.2f} erlang:")
print(f"  3 groups of 10 channels (load {total_load/3:.2f} each): B = {erlang_b(total_load/3, 10):.4f}")
print(f"  1 group of 30 channels  (load {total_load:.2f})      : B = {erlang_b(total_load, 30):.4f}")
