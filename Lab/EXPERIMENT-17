import math

def valid_cluster_sizes(limit=20):
    """N = i^2 + i*j + j^2 for non-negative integers i, j (N >= 1)."""
    return sorted({i*i + i*j + j*j for i in range(5) for j in range(5)} - {0})[:limit]

def reuse_metrics(N, S=336, M=21, n=4.0):
    k = S // N                              # channels per cell
    q = math.sqrt(3 * N)                    # co-channel reuse ratio D/R
    si_db = 10 * math.log10(q ** n / 6)     # six first-tier interferers
    return k, M * k, q, si_db

# ---- parameters ----
S, M, n, req = 336, 21, 4.0, 18.0

print(f"S = {S} channels, M = {M} cells, path-loss exponent n = {n}, required S/I = {req} dB")
print(f"{'N':>3} {'D/R':>6} {'ch/cell':>8} {'capacity':>9} {'S/I (dB)':>9}  Meets {req} dB?")
best = None
for N in valid_cluster_sizes(10):
    k, C, q, si = reuse_metrics(N, S, M, n)
    ok = si >= req
    if ok and best is None:
        best = N
    print(f"{N:3d} {q:6.2f} {k:8d} {C:9d} {si:9.2f}  {'yes' if ok else 'no'}")
print("Smallest cluster size that meets the S/I requirement: N =", best)
